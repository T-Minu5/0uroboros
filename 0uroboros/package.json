{
  "name": "0uroboros",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "0uroboros, the circuit and the serpent. Competitive deck-building strategy card game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "openai:test": "tsx scripts/openai-smoke-test.ts",
    "swarm": "tsx src/swarm/cli.ts",
    "swarm:smoke": "tsx src/swarm/cli.ts --smoke",
    "swarm:review": "tsx src/swarm/cli.ts --reviewer",
    "swarm:research": "tsx src/swarm/cli.ts --research",
    "swarm:lookdev": "tsx src/swarm/cli.ts --lookdev",
    "swarm:inspect-visuals": "tsx src/swarm/cli.ts --inspect-visuals",
    "swarm:creative": "tsx src/swarm/cli.ts --creative",
    "swarm:world-knowledge": "tsx src/swarm/cli.ts --world-knowledge",
    "swarm:worldbuilding": "tsx src/swarm/cli.ts --worldbuilding",
    "canonical:sync": "tsx scripts/sync-canonical.ts",
    "delivery": "tsx src/delivery/cli.ts"
  },
  "dependencies": {
    "@openai/agents": "^0.17.0",
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@use-gesture/react": "^10.3.1",
    "boardgame.io": "^0.50.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.49.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
