{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "0uroboros WorkPackage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "objective",
    "owner_role",
    "authorized_rule_ids",
    "authorized_tech_ids",
    "scope",
    "files_or_domains_allowed",
    "dependencies",
    "acceptance_criteria",
    "tests_required",
    "authority_level",
    "approval_required",
    "execution_tools_allowed",
    "canonical_version"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "authorized_rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authorized_tech_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_or_domains_allowed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tests_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_level": {
      "enum": [
        "ADVISORY",
        "IMPLEMENTATION",
        "CANONICAL_MUTATION",
        "DESTRUCTIVE"
      ]
    },
    "approval_required": {
      "type": "boolean"
    },
    "execution_tools_allowed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canonical_version": {
      "type": "string"
    }
  }
}