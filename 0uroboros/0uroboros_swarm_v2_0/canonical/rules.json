      ],
      "supersedes": [],
      "superseded_by": [],
      "document": "01_APPROVED_RULES.md"
    },
    {
      "id": "RULE-STARTER-006",
      "domain": "RULE",
      "status": "current",
      "version": "2.0.0",
      "text": "`RULE-STARTER-006` Vault Encryption x2: VP. Power 2. `Restore 100.` Cost 3.",
      "tags": [
        "rule"
      ],
