    },
    {
      "id": "RULE-STARTER-005",
      "domain": "RULE",
      "status": "current",
      "version": "2.0.0",
      "text": "`RULE-STARTER-005` Rezz-Blade: Power 3. `Drain 100. +1 Card. +2 Actions.` Cost 4.",
      "tags": [
