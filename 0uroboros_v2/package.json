{
  "name": "0uroboros-runtime-v1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node --watch-path=server --watch-path=packages/engine/src/ai/strategy.ts --watch-path=packages/engine/src/effects/migrate.ts --watch-preserve-output node_modules/vite/bin/vite.js",
    "build": "npm run depth:check && npm run assets:check && tsc --noEmit && npm run lint:boundaries && vite build",
    "build:client": "npm run assets:check && tsc --noEmit && npm run lint:boundaries && OUROBOROS_TARGET=client vite build && node scripts/check-client-bundle.mjs dist/client",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "assets:manifest": "node scripts/build-art-manifest.mjs",
    "assets:optimise": "node scripts/optimise-assets.mjs",
    "assets:check": "node scripts/optimise-assets.mjs --check && node scripts/build-art-manifest.mjs --check",
    "depth:setup": "bash tools/depth/setup.sh",
    "depth:build": "node scripts/build-depth.ts",
    "depth:check": "node scripts/build-depth.ts --check",
    "test:depth-art": "node scripts/depth-art-smoke.mjs",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:pointer": "node scripts/board-pointer-smoke.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:motion": "node scripts/cycle-motion-smoke.mjs",
    "test:timer": "node scripts/timer-smoke.mjs",
    "test:strategic": "node scripts/strategic-browser-smoke.mjs",
    "test:draft-layout": "node scripts/draft-layout-smoke.mjs",
    "test:authoring": "node scripts/authoring-browser-smoke.mjs",
    "test:card-effects": "node scripts/card-effects-browser-smoke.mjs",
    "test:card-styles": "node scripts/card-style-browser-smoke.mjs",
    "test:perf": "node scripts/perf-probe.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@vitejs/plugin-react": "^5.1.1",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "vitest": "^3.2.4"
  }
}
