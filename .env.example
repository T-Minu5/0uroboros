# OpenAI project API key from https://platform.openai.com/api-keys
# Copy this file to .env. Never commit the real .env file.
OPENAI_API_KEY=
OPENAI_TEST_MODEL=

# Swarm v2.0 model routing. Role names stay stable; IDs live only here.
ASTRA_MODEL=gpt-6-astra
ENGINEERING_MODEL=gpt-5.6-sol
SPECIALIST_MODEL=gpt-5.6-terra
UTILITY_MODEL=gpt-5.6-luna
REVIEWER_MODEL=gpt-5.6-sol
EXECUTION_MODEL=gpt-5.6-sol
ALLOW_MODEL_FALLBACK=false
ASTRA_FALLBACK_MODEL=gpt-5.6-sol
# Optional. Astra accepts low, medium, high, xhigh, max. Not none.
ASTRA_REASONING_EFFORT=

# RunBudget
AGENT_MAX_TURNS=10
MAX_TOTAL_AGENT_CALLS=8
MAX_SPECIALIST_CALLS_PER_RUN=6
MAX_REVIEW_CALLS=1
MAX_RESEARCH_CALLS=1
MAX_RESEARCH_SOURCES=6
MAX_RESEARCH_FINDINGS=5
MAX_RESEARCH_PROPOSALS=5
MAX_LOOKDEV_CALLS=1
MAX_LOOKDEV_FINDINGS=5
MAX_LOOKDEV_RECOMMENDATIONS=5
MAX_LOOKDEV_CONCEPTS=3
MAX_CONTENT_CALLS=1
MAX_CONTENT_PROPOSALS=5
MAX_WORLDBUILDING_CALLS=1
MAX_WORLDBUILDING_CONCEPTS=5
MAX_CREATIVE_CONCEPTS_PER_RUN=5
MAX_EXECUTION_CALLS=1
MAX_CONFLICT_ROUNDS=2
MAX_PROPOSALS_PER_AGENT=5
AGENT_RETRY_LIMIT=1
MAX_VISUAL_ASSETS_PER_INSPECTION=4
# Keep false unless you are intentionally inspecting one first-party image.
VISUAL_INSPECTION_LIVE=false

# Optional. Worldbuilding reads Mel's Obsidian vault through MCP Connector (mcp-tools-istefox).
# Leave the token blank to discover the local plugin token from the open vault. Do not commit it.
OBSIDIAN_MCP_URL=http://127.0.0.1:27200/mcp
OBSIDIAN_MCP_TOKEN=
